// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  token     String    @unique @db.VarChar
  userId    BigInt    @map("user_id")
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "ix_refresh_token_user_id")
  @@map("refresh_token")
}

model User {
  id            BigInt         @id @default(autoincrement())
  username      String         @unique @db.VarChar
  password      String         @db.VarChar
  avatarUrl     String?        @map("avatar_url") @db.VarChar
  role          UserRoleEnum
  refreshTokens RefreshToken[]

  @@map("user")
}

model Category {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  products Product[]

  @@map("category")
}

model Brand {
  id       BigInt    @id @default(autoincrement())
  name     String    @db.VarChar(100)
  slug     String    @unique @db.VarChar(100)
  products Product[]

  @@map("brand")
}

model Size {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(10)

  products Product[]

  @@map("size")
}

model Product {
  id          BigInt     @id @default(autoincrement())
  title       String     @db.VarChar(255)
  slug        String     @unique @db.VarChar(300)
  description String
  price       Decimal    @db.Decimal(10, 2)
  salePrice   Decimal?   @map("sale_price") @db.Decimal(10, 2)
  gender      GenderEnum @default(MALE)
  isPublished Boolean    @default(false) @map("is_published")
  isArchived  Boolean    @default(false) @map("is_archived")

  categoryId BigInt? @map("category_id")
  brandId    BigInt? @map("brand_id")

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brand    Brand?         @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sizes    Size[]
  images   ProductImage[]

  @@index([categoryId], map: "ix_product_category_id")
  @@index([brandId], map: "ix_product_brand_id")
  @@map("product")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  url       String  @db.VarChar(500)
  alt       String? @db.VarChar(255)
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "ix_product_image_product_id")
  @@map("product_image")
}

enum UserRoleEnum {
  ADMIN
  USER

  @@map("userroleenum")
}

enum GenderEnum {
  MALE
  FEMALE

  @@map("genderenum")
}
